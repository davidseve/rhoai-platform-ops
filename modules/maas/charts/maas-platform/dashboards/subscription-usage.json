{
  "title": "MaaS Subscription Usage",
  "uid": "maas-subscription-usage",
  "description": "Per-subscription breakdown of requests and tokens. Requires MaaSAuthPolicy to populate the subscription label.",
  "tags": ["maas", "subscriptions", "kuadrant", "usage"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(authorized_calls, subscription)",
        "hide": 0,
        "includeAll": true,
        "label": "Subscription",
        "multi": true,
        "name": "subscription",
        "query": "label_values(authorized_calls, subscription)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Authorized Requests/sec",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(authorized_calls{subscription=~\"$subscription\"}[5m]))", "legendFormat": "Authorized", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rate Limited/sec",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(limited_calls{subscription=~\"$subscription\"}[5m]))", "legendFormat": "Limited", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.5 }] }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Token Throughput (authorized)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(authorized_hits{subscription=~\"$subscription\"}[5m]))", "legendFormat": "Tokens/sec", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "green" } } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rejection Ratio",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(limited_calls{subscription=~\"$subscription\"}[5m])) / (sum(rate(authorized_calls{subscription=~\"$subscription\"}[5m])) + sum(rate(limited_calls{subscription=~\"$subscription\"}[5m])))", "legendFormat": "Rejection %", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 1, "noValue": "0%",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.3 }] }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Authorized Calls by Subscription",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "sum by(subscription) (rate(authorized_calls{subscription=~\"$subscription\"}[5m]))", "legendFormat": "{{subscription}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineInterpolation": "smooth", "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Limited Calls by Subscription",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "sum by(subscription) (rate(limited_calls{subscription=~\"$subscription\"}[5m]))", "legendFormat": "{{subscription}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineInterpolation": "smooth", "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Token Throughput by Model (vLLM)",
      "description": "Generation and prompt tokens per model",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "sum by(model_name) (rate(kserve_vllm:generation_tokens_total[5m]))", "legendFormat": "{{model_name}} gen tokens/s" },
        { "refId": "B", "expr": "sum by(model_name) (rate(kserve_vllm:prompt_tokens_total[5m]))", "legendFormat": "{{model_name}} prompt tokens/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Token Consumption by Subscription",
      "description": "Authorized tokens (hits) per subscription over time",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "sum by(subscription) (rate(authorized_hits{subscription=~\"$subscription\"}[5m]))", "legendFormat": "{{subscription}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth", "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    }
  ]
}
