{
  "title": "MaaS Subscription Usage",
  "uid": "maas-subscription-usage",
  "description": "Per-subscription request and token breakdown using Limitador native metrics (authorized_calls, authorized_hits, limited_calls). Per-user metrics require upstream maas-api /metrics support.",
  "tags": ["maas", "subscriptions", "kuadrant", "usage", "rate-limiting"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "hide": 0,
        "includeAll": true,
        "label": "Subscription",
        "multi": true,
        "name": "subscription",
        "options": [],
        "query": "label_values(authorized_calls, subscription)",
        "refresh": 2,
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Authorized Requests/sec",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(authorized_calls{subscription=~\"$subscription\"}[5m]))", "legendFormat": "Authorized", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rate-Limited Requests/sec",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(limited_calls{subscription=~\"$subscription\"}[5m]))", "legendFormat": "Limited", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.5 }] }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Token Consumption/sec",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(authorized_hits{subscription=~\"$subscription\"}[5m]))", "legendFormat": "Tokens/sec", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "green" } } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rejection Ratio",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(limited_calls{subscription=~\"$subscription\"}[5m])) / (sum(rate(authorized_calls{subscription=~\"$subscription\"}[5m])) + sum(rate(limited_calls{subscription=~\"$subscription\"}[5m])))", "legendFormat": "Rejection %", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 1, "noValue": "0%",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.3 }] }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Authorized vs Rate-Limited by Subscription",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "sum by(subscription) (rate(authorized_calls{subscription=~\"$subscription\"}[5m]))", "legendFormat": "{{subscription}} authorized" },
        { "refId": "B", "expr": "sum by(subscription) (rate(limited_calls{subscription=~\"$subscription\"}[5m]))", "legendFormat": "{{subscription}} limited" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineInterpolation": "smooth" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests by Model",
      "description": "Successful requests per model via Istio gateway metrics",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "label_replace(sum by(destination_service_name) (rate(istio_requests_total{source_workload=~\"maas-default-gateway.*\", response_code=\"200\"}[5m])), \"model\", \"$1\", \"destination_service_name\", \"(.*)-kserve-workload-svc\")", "legendFormat": "{{model}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth", "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rejection Rate by Subscription",
      "description": "Percentage of requests rate-limited per subscription (limited_calls / total calls)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "sum by(subscription) (rate(limited_calls{subscription=~\"$subscription\"}[5m])) / (sum by(subscription) (rate(authorized_calls{subscription=~\"$subscription\"}[5m])) + sum by(subscription) (rate(limited_calls{subscription=~\"$subscription\"}[5m])))", "legendFormat": "{{subscription}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth" },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.3 }] }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Token Consumption by Subscription",
      "description": "Tokens consumed per subscription (authorized_hits from Limitador). Tracks token usage against tier budgets.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "sum by(subscription) (rate(authorized_hits{subscription=~\"$subscription\"}[5m]))", "legendFormat": "{{subscription}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Token Throughput by Model (vLLM)",
      "description": "Generation and prompt tokens per model",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "sum by(model_name) (rate(kserve_vllm:generation_tokens_total[5m]))", "legendFormat": "{{model_name}} gen tokens/s" },
        { "refId": "B", "expr": "sum by(model_name) (rate(kserve_vllm:prompt_tokens_total[5m]))", "legendFormat": "{{model_name}} prompt tokens/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Gateway Latency by Model (P50/P99)",
      "description": "Request duration percentiles at the gateway, grouped by model",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "label_replace(histogram_quantile(0.50, sum by(le, destination_service_name) (rate(istio_request_duration_milliseconds_bucket{source_workload=~\"maas-default-gateway.*\"}[5m]))), \"model\", \"$1\", \"destination_service_name\", \"(.*)-kserve-workload-svc\")", "legendFormat": "{{model}} P50" },
        { "refId": "B", "expr": "label_replace(histogram_quantile(0.99, sum by(le, destination_service_name) (rate(istio_request_duration_milliseconds_bucket{source_workload=~\"maas-default-gateway.*\"}[5m]))), \"model\", \"$1\", \"destination_service_name\", \"(.*)-kserve-workload-svc\")", "legendFormat": "{{model}} P99" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Errors by Model and Status Code",
      "description": "Non-success HTTP responses per model (401, 429, 500, 503)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        { "refId": "A", "expr": "label_replace(sum by(destination_service_name) (rate(istio_requests_total{source_workload=~\"maas-default-gateway.*\", response_code=\"401\"}[5m])), \"model\", \"$1\", \"destination_service_name\", \"(.*)-kserve-workload-svc\")", "legendFormat": "{{model}} 401" },
        { "refId": "B", "expr": "label_replace(sum by(destination_service_name) (rate(istio_requests_total{source_workload=~\"maas-default-gateway.*\", response_code=\"429\"}[5m])), \"model\", \"$1\", \"destination_service_name\", \"(.*)-kserve-workload-svc\")", "legendFormat": "{{model}} 429" },
        { "refId": "C", "expr": "label_replace(sum by(destination_service_name) (rate(istio_requests_total{source_workload=~\"maas-default-gateway.*\", response_code=\"500\"}[5m])), \"model\", \"$1\", \"destination_service_name\", \"(.*)-kserve-workload-svc\")", "legendFormat": "{{model}} 500" },
        { "refId": "D", "expr": "label_replace(sum by(destination_service_name) (rate(istio_requests_total{source_workload=~\"maas-default-gateway.*\", response_code=\"503\"}[5m])), \"model\", \"$1\", \"destination_service_name\", \"(.*)-kserve-workload-svc\")", "legendFormat": "{{model}} 503" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "smooth", "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "401$" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byRegexp", "options": "429$" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byRegexp", "options": "500$" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byRegexp", "options": "503$" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Subscription Summary",
      "description": "Per-subscription summary: authorized requests/sec, rate-limited/sec, rejection %, token consumption/sec",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "refId": "A", "expr": "sum by(subscription) (rate(authorized_calls{subscription=~\"$subscription\"}[5m]))", "legendFormat": "", "instant": true, "format": "table" },
        { "refId": "B", "expr": "sum by(subscription) (rate(limited_calls{subscription=~\"$subscription\"}[5m]))", "legendFormat": "", "instant": true, "format": "table" },
        { "refId": "C", "expr": "sum by(subscription) (rate(limited_calls{subscription=~\"$subscription\"}[5m])) / (sum by(subscription) (rate(authorized_calls{subscription=~\"$subscription\"}[5m])) + sum by(subscription) (rate(limited_calls{subscription=~\"$subscription\"}[5m])))", "legendFormat": "", "instant": true, "format": "table" },
        { "refId": "D", "expr": "sum by(subscription) (rate(authorized_hits{subscription=~\"$subscription\"}[5m]))", "legendFormat": "", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "subscription": "Subscription",
              "Value #A": "Authorized/s",
              "Value #B": "Limited/s",
              "Value #C": "Rejection %",
              "Value #D": "Tokens/s"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Authorized/s" }, "properties": [{ "id": "unit", "value": "reqps" }, { "id": "decimals", "value": 2 }] },
          { "matcher": { "id": "byName", "options": "Limited/s" }, "properties": [{ "id": "unit", "value": "reqps" }, { "id": "decimals", "value": 2 }] },
          { "matcher": { "id": "byName", "options": "Rejection %" }, "properties": [{ "id": "unit", "value": "percentunit" }, { "id": "decimals", "value": 1 }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.3 }] } }, { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "color-background" } }] },
          { "matcher": { "id": "byName", "options": "Tokens/s" }, "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 1 }] }
        ]
      }
    }
  ]
}
